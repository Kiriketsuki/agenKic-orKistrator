[resource]
; orki_theme.tres — F5 Panels Orb and Restyle: the bordered-glow button
; language shared by every legacy UI surface (quest board, dialogs, scroll
; chrome, and any remaining flat button). Dark fill, 1px accent border, a
; glow on hover and focus (StyleBoxFlat shadow), and letter-spaced caps via
; a shared FontVariation. Button text is already authored in ALL CAPS across
; the codebase (e.g. power_flyout.gd's "BANISH ALL AGENTS"), so this theme
; supplies the spacing only and does not attempt a text-transform.
default_font = SubResource("FontVariation_caps")
default_font_size = 13
Button/styles/normal = SubResource("StyleBoxFlat_btn_normal")
Button/styles/hover = SubResource("StyleBoxFlat_btn_hover")
Button/styles/pressed = SubResource("StyleBoxFlat_btn_pressed")
Button/styles/focus = SubResource("StyleBoxFlat_btn_focus")
Button/styles/disabled = SubResource("StyleBoxFlat_btn_disabled")
Button/colors/font_color = Color(0.82, 0.88, 0.86, 1)
Button/colors/font_hover_color = Color(0.95, 1, 0.98, 1)
Button/colors/font_pressed_color = Color(1, 1, 1, 1)
Button/colors/font_disabled_color = Color(0.5, 0.5, 0.5, 0.6)
Button/fonts/font = SubResource("FontVariation_caps")
Button/font_sizes/font_size = 13
Label/colors/font_color = Color(0.82, 0.88, 0.86, 1)
Label/fonts/font = SubResource("FontVariation_caps")
Panel/styles/panel = SubResource("StyleBoxFlat_panel")
PopupPanel/styles/panel = SubResource("StyleBoxFlat_panel")
LineEdit/styles/normal = SubResource("StyleBoxFlat_btn_normal")
LineEdit/styles/focus = SubResource("StyleBoxFlat_btn_focus")
ItemList/styles/panel = SubResource("StyleBoxFlat_panel")
